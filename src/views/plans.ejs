<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>dJournal Plans</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT"
      crossorigin="anonymous"
    />
    <script>
      (() => {
        const storedTheme = localStorage.getItem("theme");
        const preferredTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        document.documentElement.setAttribute("data-bs-theme", storedTheme || preferredTheme);
      })();
    </script>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
      <div class="container-fluid">
        <a class="navbar-brand" href="/"><%= navbar %></a>
        <button
          class="btn btn-outline-secondary ms-auto"
          type="button"
          id="themeToggle"
          aria-label="Toggle dark theme"
          title="Toggle theme"
        >
          <span id="themeLabel">Dark</span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link" href="/">Journal</a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="/plans">Plans</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container mt-3">
      <div class="row g-3">
        <section class="col-md-7">
          <div class="border rounded p-2" style="max-height: 500px; overflow-y: auto; overflow-x: hidden">
            <% if (plans.length === 0) { %>
              <p class="text-body-secondary m-2">No plans yet.</p>
            <% } %>

            <% plans.forEach(plan => { %>
              <article class="card text-start mb-2">
                <div class="card-body">
                  <h5 class="card-title"><%= plan.title %></h5>
                  <h6 class="card-subtitle mb-2 text-body-secondary"><%= plan.date %></h6>
                  <% const planFinishDate = plan.finishDate || plan.dueDate; %>
                  <% if (planFinishDate) { %>
                    <p class="mb-1">
                      <span class="fw-semibold">Finish by:  <%= planFinishDate %></span>
                      <span class="fw-bold">Difficulty: <%= plan.difficulty %></span>
                     
                    </p>
                  <% } %>
                  <p class="card-text"><%= plan.description %></p>

                  <div class="d-flex gap-2">
                    <a class="btn btn-primary" href="/plans/edit/<%= plan.id %>">Edit</a>
                    <form method="post" action="/plans/delete/<%= plan.id %>">
                      <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>
        </section>

        <section class="col-md-5">
          <form class="border rounded p-3" method="post" action="<%= formAction %>">
            <div class="mb-3">
              <label for="title" class="form-label">Title</label>
              <input
                type="text"
                class="form-control"
                id="title"
                name="title"
                placeholder="Plan..."
                value="<%= input.title %>"
                required
              />
            </div>

            <div class="mb-3">
              <label for="description" class="form-label">Description</label>
              <textarea
                style="height: 10rem"
                class="form-control"
                id="description"
                name="description"
                required
              ><%= input.description %></textarea>
            </div>

            <div class="mb-3">
              <label for="finishDate" class="form-label">Finish Date</label>
              <input
                type="date"
                class="form-control"
                id="finishDate"
                name="finishDate"
                value="<%= input.finishDate %>"
                required
              />
            </div>

            <div class="mb-3">
              <label for="difficulty" class="form-label">
                Difficulty: <span id="difficultyValue"><%= input.difficulty %></span>/10
              </label>
              <input
                type="range"
                class="form-range"
                id="difficulty"
                name="difficulty"
                min="1"
                max="10"
                step="1"
                value="<%= input.difficulty %>"
              />
            </div>

            <button type="submit" class="btn btn-primary"><%= submitLabel %></button>
          </form>
        </section>
      </div>
    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO"
      crossorigin="anonymous"
    ></script>
    <script>
      const themeToggle = document.getElementById("themeToggle");
      const themeLabel = document.getElementById("themeLabel");
      const difficulty = document.getElementById("difficulty");
      const difficultyValue = document.getElementById("difficultyValue");
      const root = document.documentElement;

      const updateThemeLabel = () => {
        themeLabel.textContent = root.getAttribute("data-bs-theme") === "dark" ? "Light" : "Dark";
      };

      themeToggle.addEventListener("click", () => {
        const nextTheme = root.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-bs-theme", nextTheme);
        localStorage.setItem("theme", nextTheme);
        updateThemeLabel();
      });

      updateThemeLabel();

      difficulty.addEventListener("input", () => {
        difficultyValue.textContent = difficulty.value;
      });
    </script>
  </body>
</html>
